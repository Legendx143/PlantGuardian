# ==========================================
# Frontend (Vite + React) .gitignore
# ==========================================

# ── Dependencies ──
node_modules/
.pnpm-store/

# ── Build & Cache Outputs ──
dist/
dist-ssr/
.vite/
*.local

# ── Environment & Secrets ──
.env
.env.*
*.env
*.env.local
!.env.example

# ── Logs & Debugging ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Editor Directories & OS Artifacts ──
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
