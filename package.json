{
  "name": "plantguardian-root",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PlantGuardian Workspace Root",
  "workspaces": [
    "Frontend",
    "Backend"
  ],
  "scripts": {
    "dev": "node run_dev.js",
    "dev:all": "node run_dev.js",
    "dev:frontend": "npm --prefix Frontend run dev",
    "dev:backend": "npm --prefix Backend run dev",
    "build": "npm --prefix Frontend run build",
    "start": "npm --prefix Backend run start",
    "lint": "npm --prefix Frontend run lint"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.90.1",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "nodemailer": "^10.3.1"
  }
}
